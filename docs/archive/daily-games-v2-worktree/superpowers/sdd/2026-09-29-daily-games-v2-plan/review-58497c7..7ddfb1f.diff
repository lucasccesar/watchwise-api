+package com.watchwise.watchwise_api.dailygame.service;
+
+import com.watchwise.watchwise_api.dailygame.dto.DailyGameAttemptDTO;
+import com.watchwise.watchwise_api.dailygame.dto.DailyGameCandidateDTO;
